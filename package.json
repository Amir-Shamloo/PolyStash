{
  "name": "polystash",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source digital asset manager for 3D/AEC/design files",
  "scripts": {
    "dev": "pnpm --filter @polystash/desktop dev",
    "build": "pnpm --filter @polystash/desktop build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^9.13.0"
  }
}
